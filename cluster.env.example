# Copy to `cluster.env`, fill in, and optionally use with your own wrapper script
# (e.g. `envsubst` on a patch file). CAAPH is the only GitOps mode this repo documents.
# bootstrap-capi.sh: --workload-gitops-mode caaph, --workload-app-of-apps-git-*, and (optional) operator vs Helm:
# export WORKLOAD_ARGOCD_HELM_VIA_CAAPH=false   # default: Argo from Argo CD Operator; CAAPH only deploys argocd-apps
# export WORKLOAD_ARGOCD_HELM_VIA_CAAPH=true    # opt-in: also install the argo-cd Helm chart on the workload via CAAPH
#
# Secrets: this repo is credential-free. Cluster Secrets (e.g. for Proxmox CSI) are populated on
# the destination cluster—see Argo CD secret management docs and the Secrets Store CSI driver:
# https://argo-cd.readthedocs.io/en/stable/operator-manual/secret-management/
# https://github.com/kubernetes-sigs/secrets-store-csi-driver

# Git remote for this app-of-apps repo (bootstrap-capi.sh defaults to the public repo below)
# export WORKLOAD_APP_OF_APPS_GIT_URL=https://github.com/lpasquali/workload-app-of-apps.git

# Kustomize path under the repo: root Application source.path
# export WORKLOAD_APP_OF_APPS_GIT_PATH=examples/default
# export WORKLOAD_APP_OF_APPS_GIT_PATH=examples/k8s-only
# export WORKLOAD_APP_OF_APPS_GIT_PATH=examples/proxmox-secret-name
# export WORKLOAD_APP_OF_APPS_GIT_PATH=clusters/prod-foo

# export WORKLOAD_APP_OF_APPS_GIT_REF=main

# CAPI/Cluster name on the management cluster (root Application .metadata.name; not the same as
# the child `Application` names in this tree)
# export WORKLOAD_CLUSTER_NAME=my-workload
